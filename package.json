{
  "name": "owlsync-monorepo",
  "private": true,
  "packageManager": "npm@10.8.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "prisma:generate": "npx prisma generate --schema=./packages/database/prisma/schema.prisma",
    "start:api": "node apps/api/src/server.js",
    "desktop:dev": "npm --prefix apps/desktop run dev",
    "desktop:build": "npm --prefix apps/web run build && npm --prefix apps/desktop run build:win",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "turbo": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "helmet": "^8.3.0",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1"
  }
}
