# ==============================================================================
# OwlSync Environment Configuration Template
# Copy this file to .env and fill in your values
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL 15)
# ------------------------------------------------------------------------------
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL="postgresql://root:password@127.0.0.1:5432/owlsync?schema=public"

# ------------------------------------------------------------------------------
# 3. Redis (Cache, Distributed Locks, Rate Limiting & Pub/Sub)
# ------------------------------------------------------------------------------
REDIS_URL="redis://127.0.0.1:6379"

# ------------------------------------------------------------------------------
# 4. RabbitMQ Message Broker (Background Workers)
# ------------------------------------------------------------------------------
RABBITMQ_URL="amqp://127.0.0.1:5672"

# ------------------------------------------------------------------------------
# 5. Authentication & JWT Security
# ------------------------------------------------------------------------------
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS=30

# ------------------------------------------------------------------------------
# 6. AI Pair Programmer Integrations
# ------------------------------------------------------------------------------
# Google Gemini API Key (Get at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API Key (if using OpenAI models)
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 7. OAuth 2.0 Providers (Optional)
# ------------------------------------------------------------------------------
# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ------------------------------------------------------------------------------
# 8. Transactional Email Worker (SMTP / Ethereal)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="OwlSync <your_email@gmail.com>"
